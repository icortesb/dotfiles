{
  "custom/claude": {
    "icon": "󰚩",
    "label": "{label}",
    "tooltip": "{tooltip}",
    "execute": "$HOME/.config/hyprpanel/scripts/claude-usage-label.sh",
    "interval": 300000,
    "hideOnEmpty": false,
    "actions": {
      "onLeftClick": "$HOME/.config/hyprpanel/scripts/claude-usage-notify.sh",
      "onRightClick": "kitty --hold -e $HOME/.config/hyprpanel/scripts/claude-usage-show.sh"
    }
  },
  "custom/mobidb": {
    "label": "{text}",
    "tooltip": "{tooltip}",
    "execute": "mobidb-tunnel status",
    "interval": 5000,
    "hideOnEmpty": true,
    "actions": {
      "onLeftClick": "mobidb-tunnel connect",
      "onRightClick": "mobidb-tunnel disconnect"
    }
  },
  "custom/iwd": {
    "label": "{text}",
    "tooltip": "{tooltip}",
    "execute": "$HOME/.config/hyprpanel/scripts/iwd-status.sh",
    "interval": 5000,
    "hideOnEmpty": false,
    "actions": {
      "onLeftClick": "$HOME/.config/hyprpanel/scripts/iwd-menu.sh",
      "onRightClick": "sh -c 'for x in /sys/class/net/*/wireless; do [ -e \"$x\" ] && iwctl station \"$(basename $(dirname $x))\" disconnect && exit; done'"
    }
  }
}
